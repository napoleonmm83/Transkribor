    },
    {
      "id": "orb-3 Phase ohne Farbregel",
      "datei": "webtool/frontend/src/index.css",
      "von": ".orb[data-phase=\"diarize\"]",
      "nach": ".orb[data-phase=\"diarisieren\"]",
      "rot": ["jede Phase hat eine Farbregel"]
    },
    {
      "id": "orb-4 reduced-motion-Stopp fehlt",
      "datei": "webtool/frontend/src/index.css",
      "von": "  .orb, .orb::after { animation: none; }",
