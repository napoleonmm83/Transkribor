{
  "test": "npm --prefix webtool/frontend test -- FileStatusPill ThinkingOrb",
  "pfade": [
    "webtool/frontend/src/components/ThinkingOrb.tsx",
    "webtool/frontend/src/components/ThinkingOrb.test.tsx",
    "webtool/frontend/src/components/FileStatusPill.tsx",
    "webtool/frontend/src/components/FileStatusPill.test.tsx"
  ],
  "mutationen": [
    {
      "id": "orb-1 data-phase weggelassen",
      "datei": "webtool/frontend/src/components/ThinkingOrb.tsx",
      "von": "data-phase={phase ?? undefined}",
      "nach": "data-phase={undefined}",
      "rot": ["der Thinking Orb traegt die laufende Phase"]
    },
    {
      "id": "orb-2 Pille reicht die Phase nicht durch",
      "datei": "webtool/frontend/src/components/FileStatusPill.tsx",
      "von": "<ThinkingOrb phase={active} />",
      "nach": "<ThinkingOrb />",
      "rot": ["der Thinking Orb traegt die laufende Phase"]
    },
    {
      "id": "orb-3 Phase ohne Abbildung",
      "datei": "webtool/frontend/src/components/ThinkingOrb.tsx",
      "von": "  diarize: { state: 'connecting', color: '#0891B2' },\n",
      "nach": "",
      "rot": ["jede Phase hat eine eigene Animation und Farbe"]
    }
  ]
}
