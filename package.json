{
  "name": "transkribor",
  "productName": "Transkribor",
  "version": "0.1.0",
  "private": true,
  "description": "Interview-Transkription (Whisper, lokal) mit KI-Korrektur und Sprecher-Labeling",
  "author": {
    "name": "Marcus Martini",
    "email": "marcusmartini83@gmail.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "npm --prefix webtool/frontend install && npm --prefix webtool/frontend run build",
    "start": "npm run build:frontend && electron .",
    "dist": "npm run build:frontend && electron-builder --publish never",
    "release": "npm run build:frontend && electron-builder --publish always",
    "test:electron": "node --test electron/*.test.js"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "ch.martini.transkribor",
    "productName": "Transkribor",
    "files": [
      "electron/**/*",
      "!electron/*.test.js",
      "!**/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "py",
        "filter": [
          "webtool/**/*",
          "transcribe.py",
          "requirements.txt",
          "CLAUDE.md",
          "!webtool/frontend/**",
          "!webtool/test_*.py",
          "!**/__pycache__/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Transkribor"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "napoleonmm83",
        "repo": "Transkribor"
      }
    ]
  },
  "allowScripts": {
    "electron@43.3.0": true
  }
}
