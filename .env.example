# Transkribor — lokale Konfiguration.
# Diese Datei nach `.env` kopieren (git-ignoriert) und ausfüllen; `.\webtool.ps1` lädt sie beim Start.

# HuggingFace Read-Token für die pyannote-Sprecher-Diarisierung (Stufe 3).
#   1) Token erstellen (Type: Read):        https://huggingface.co/settings/tokens
#   2) Modellbedingungen akzeptieren:        https://huggingface.co/pyannote/speaker-diarization-community-1
# Ohne Token läuft alles wie bisher, nur ohne akustische Sprecher-Trennung.
HF_TOKEN=

# Diarisierung server-weit abschalten (Default: an). Werte: 0 / false / no
# TRANSKRIBOR_DIARIZE=1
